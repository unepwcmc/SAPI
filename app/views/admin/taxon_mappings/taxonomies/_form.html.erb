<%= form_for :taxonomy, url: collection_url, remote: true do |f| %>
  <%= error_messages_for(@taxonomy) %>

  <label>Code</label>
  <%= f.text_field :code, placeholder: 'IUCNRL' %>
  <span class="help-block">
    What the API is addressed by, so it has to match what callers will send.
  </span>

  <label>Name</label>
  <%= f.text_field :name, placeholder: 'IUCN Red List' %>
<% end %>
